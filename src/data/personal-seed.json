    "demo-explore-engage": {
      "id": "demo-explore-engage",
      "title": "示例：Engage 阶段",
      "description": "Engage 表示你已经承诺真实投入。\n\n进入这里不是「继续观望」，而是开始行动：深入阅读、做实验、写笔记、拆任务或接入滴答清单。Engage 的上限更紧，只留给真正在推进的事项。\n\n适合：正在动手做的学习项目、需要连续投入的研究。",
      "board": "explore",
      "category": "课程 / 体验",
      "topics": [
        "入门示例"
      ],
      "stage": "engage",
      "capturedAt": "2026-01-01T00:00:00.000Z",
